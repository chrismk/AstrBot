{
  "session_timeout": {
    "type": "int",
    "description": "会话超时时间（分钟）",
    "default": 2
  },
  "max_subscriptions_per_user": {
    "type": "int",
    "description": "每用户最大订阅数",
    "default": 20
  },
  "default_push_time": {
    "type": "string",
    "description": "默认推送时间（HH:MM格式）",
    "default": "19:00"
  },
  "push_check_interval": {
    "type": "int",
    "description": "推送检查间隔（秒）",
    "default": 60
  },
  "push_batch_size": {
    "type": "int",
    "description": "批量推送大小",
    "default": 50
  },
  "push_concurrency": {
    "type": "int",
    "description": "推送并发数",
    "default": 10
  }
}
